# Veyra Python Processing API Configuration

# Server Port
PORT=8000

# CORS Settings (for backend domain)
# BACKEND_URL=http://localhost:3001
# FRONTEND_URL=http://localhost:8081

# Tesseract OCR Path (Windows)
# Update this path if Tesseract is installed in a different location
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# File Upload Limits
MAX_FILE_SIZE=20971520
MAX_PDF_PAGES=20
MAX_TEXT_LENGTH=100000

# Whisper Model (base, small, medium, large)
WHISPER_MODEL=base

# Whisper Compute Type (int8, float16, float32)
WHISPER_COMPUTE_TYPE=int8

# Database Configuration (if needed)
# DATABASE_URL=

# Logging
# LOG_LEVEL=INFO
